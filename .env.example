# ===================================================================
# ENTERPRISE ORDER & INVENTORY MANAGEMENT PLATFORM
# Production Environment Configuration Template
# ===================================================================

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Production Oracle Database Configuration
DB_HOST=oracle-db-host.example.com
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=ENTERPRISE_DB
DB_PASSWORD=YOUR_ORACLE_SECURE_PASSWORD

# Security & Authentication (JWT Secret: minimum 256-bit / 32-character random string)
JWT_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# CORS / Frontend Domain Origin
FRONTEND_URL=https://your-deployed-frontend.vercel.app

# Optional Full Oracle JDBC Connection String Override
# DB_URL=jdbc:oracle:thin:@//oracle-db-host.example.com:1521/FREEPDB1
