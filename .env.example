# ===================================================================
# ENTERPRISE ORDER & INVENTORY MANAGEMENT PLATFORM
# Production Environment Configuration Template
# ===================================================================

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Production MySQL Database Configuration
DB_HOST=mysql-db-host.example.com
DB_PORT=3306
DB_NAME=enterprise_db
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_SECURE_PASSWORD

# Security & Authentication (JWT Secret: minimum 256-bit / 32-character random string)
JWT_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# CORS / Frontend Domain Origin
FRONTEND_URL=https://your-deployed-frontend.vercel.app

# Optional Full MySQL JDBC Connection String Override
# DB_URL=jdbc:mysql://mysql-db-host.example.com:3306/enterprise_db
