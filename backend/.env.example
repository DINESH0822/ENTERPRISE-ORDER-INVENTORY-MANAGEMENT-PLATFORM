# ============================================================
# Backend Environment Variables — Railway
# ============================================================
# Set ALL of these in Railway Dashboard → Project → Variables
# NEVER commit actual values to git.

# ── Spring Profile ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Oracle Database ─────────────────────────────────────────
# Option 1: Oracle Cloud Autonomous DB (recommended)
#   DB_URL=jdbc:oracle:thin:@(description=(address=(protocol=tcps)(host=adb.ap-mumbai-1.oraclecloud.com)(port=1522))(connect_data=(service_name=your_service_high)))
# Option 2: Standard Oracle XE / TCP (local or VM)
#   DB_URL=jdbc:oracle:thin:@//your-host:1521/XE
DB_URL=jdbc:oracle:thin:@//YOUR_ORACLE_HOST:1521/XE

DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# Oracle Wallet path (only needed for Oracle Cloud Autonomous DB with mTLS)
# TNS_ADMIN=/app/wallet
# ORACLE_WALLET_PATH=/app/wallet

# ── JWT Security ────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_EXPIRATION_MS=86400000

# ── CORS ────────────────────────────────────────────────────
# Your Vercel frontend URL (set after Vercel deployment)
FRONTEND_URL=https://YOUR_APP_NAME.vercel.app

# ── Server ──────────────────────────────────────────────────
# Railway injects PORT automatically — do NOT change this
# PORT=8080  (injected by Railway)
